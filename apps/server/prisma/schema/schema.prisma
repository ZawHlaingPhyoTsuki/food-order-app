generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

generator prismabox {
  provider                    = "prismabox"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
  inputModel                  = true
  output                      = "../../src/generated/prismabox"
}

datasource db {
  provider = "postgresql"
}

model Todo { 
  id        Int      @id @default(autoincrement()) 
  title     String
  completed Boolean  @default(false) 
  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt
} 

// ============================================
// ORGANIZATION (RESTAURANT) MODELS
// ============================================

model Organization {
  id              String         @id @default(cuid())
  name            String         // "Som Tum Café"
  slug            String         @unique // "somtum-cafe" (for URLs)
  description     String?
  logo            String?        // URL to logo image
  
  // Contact & Address
  phone           String?
  address         String?
  city            String?
  country         String         @default("TH")
  
  // Status & Approval
  status          OrgStatus      @default(PENDING)
  approvedAt      DateTime?
  approvedBy      String?        // Admin user ID who approved
  rejectedAt      DateTime?
  rejectionReason String?
  
  // Settings
  currency        String         @default("THB")
  defaultLanguage String         @default("th")
  
  // Owner
  ownerId         String
  owner           User           @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Relations
  tables          Table[]
  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  orders          Order[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([slug])
  @@map("organizations")
}

enum OrgStatus {
  PENDING       // Awaiting admin approval
  ACTIVE        // Approved and operating
  SUSPENDED     // Temporarily disabled by admin
  REJECTED      // Application rejected
}

// ============================================
// TABLE MANAGEMENT
// ============================================

model Table {
  id              String       @id @default(cuid())
  
  // Identification
  tableNumber     String       // Display name: "1", "A1", "VIP-1"
  tableToken      String       @unique @default(cuid()) // UUID for QR code
  
  // Status
  status          TableStatus  @default(FREE)
  
  // Organization
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Relations
  orders          Order[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, tableNumber])
  @@index([tableToken])
  @@index([organizationId, status])
  @@map("tables")
}

enum TableStatus {
  FREE            // Available for customers
  OCCUPIED        // Customers seated, session active
  NEEDS_CLEANING  // Requires staff attention
  // RESERVED        // Reserved for specific time (future)
}

// ============================================
// MENU MANAGEMENT
// ============================================

model MenuCategory {
  id              String       @id @default(cuid())
  name            String       // "Appetizers", "Main Course"
  nameEn          String?      // English translation
  nameTh          String?      // Thai translation
  nameMm          String?      // Myanmar translation
  nameSh          String?      // Shan translation
  description     String?
  displayOrder    Int          @default(0)
  isActive        Boolean      @default(true)
  
  // Organization
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Relations
  menuItems       MenuItem[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, displayOrder])
  @@map("menu_categories")
}

model MenuItem {
  id              String         @id @default(cuid())
  
  // Basic Info
  name            String         // "Pad Thai"
  nameEn          String?        // English name
  nameTh          String?        // Thai name
  nameMm          String?        // Myanmar name
  nameSh          String?        // Shan name
  description     String?
  image           String?        // URL to food photo
  price           Int          // Base price in THB
  
  // Availability
  isAvailable     Boolean        @default(true)
  isFeatured      Boolean        @default(false)
  displayOrder    Int            @default(0)
  
  // Category
  categoryId      String
  category        MenuCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  // Organization
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Relations
  orderItems      OrderItem[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId, isAvailable])
  @@index([categoryId, displayOrder])
  @@map("menu_items")
}

// ============================================
// ORDER MANAGEMENT
// ============================================

model Order {
  id              String       @id @default(cuid())
  
  // Session & Table
  sessionId       String       // Links multiple orders to same dining session
  tableToken      String       // Which physical table
  tableId         String
  table           Table        @relation(fields: [tableId], references: [id])
  
  // Organization
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Order Details
  status          OrderStatus  @default(PENDING)
  orderNumber     Int          // Sequential number for display
  
  // Pricing
  subtotal        Int
  taxAmount       Int
  serviceAmount   Int
  total           Int
  
  // Payment
  isPaid          Boolean      @default(false)
  paidAt          DateTime?
  paymentMethod   String?      // "cash", "card", "promptpay"
  
  // Special Requests
  notes           String?      // Table-level notes
  
  // Relations
  items           OrderItem[]
  
  // Timestamps
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  servedAt        DateTime?

  @@index([sessionId])
  @@index([tableToken])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING         // Just placed, not started
  PREPARING       // Kitchen is working on it
  READY           // Ready to serve
  SERVED          // Delivered to table
  PAID            // Payment completed
  CANCELLED       // Cancelled by customer/staff
}

model OrderItem {
  id              String       @id @default(cuid())
  
  // Order
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Menu Item
  menuItemId      String
  menuItem        MenuItem     @relation(fields: [menuItemId], references: [id])
  
  // Quantity & Pricing
  quantity        Int
  unitPrice       Int        // Price at time of order (snapshot)
  totalPrice      Int        // unitPrice * quantity + modifiers
  
  // Customization
  specialRequest  String?      // "No onions, extra spicy"
  
  createdAt       DateTime     @default(now())

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}
