{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@food-order-app/env": "workspace:*",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "elysia": "catalog:",
    "pg": "^8.19.0",
    "prismabox": "^1.1.26",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@food-order-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "bun-types": "^1.3.10",
    "prisma": "^7.4.2",
    "tsdown": "^0.16.5",
    "typescript": "catalog:"
  }
}
